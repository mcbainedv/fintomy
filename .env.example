# Copy to .env and adjust as needed:  cp .env.example .env

# --- Timezone (used for the daily 17:00 scrape and UI timestamps) -------------
TZ=Europe/Belgrade

# --- MariaDB ----------------------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=fintomy
MARIADB_USER=fintomy
MARIADB_PASSWORD=fintomy

# SQLAlchemy URL used by backend + scraper (host "db" = the compose service).
DATABASE_URL=mysql+pymysql://fintomy:fintomy@db:3306/fintomy?charset=utf8mb4

# --- Scraper --------------------------------------------------------------------
# Daily scheduled scrape time, local to TZ above.
SCRAPE_HOUR=17
SCRAPE_MINUTE=0
# How far back the initial one-off backfill goes (yfinance period string).
BACKFILL_PERIOD=2y
# Incremental window pulled on each scheduled/manual run.
DAILY_PERIOD=1mo
# Set to 1 to also scrape immediately on container start (besides backfill).
SCRAPE_ON_START=0

# --- Web UI -------------------------------------------------------------------
# Host port for the browser UI.
WEB_PORT=6001
# Optional: expose MariaDB on the host for debugging (set to e.g. 6002).
DB_HOST_PORT=
